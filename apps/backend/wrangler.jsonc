{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bdv-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Barcelo Digital Ventures API"
  },
  "observability": {
    "enabled": true
  }
}
