{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@bdv/shared": ["../../packages/shared/src/index.ts"],
      "@bdv/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
